<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="45"
                android:startColor="#020B25"
                android:centerColor="#0756B7"
                android:endColor="#021535" />
        </shape>
    </item>

    <item
        android:width="180dp"
        android:height="180dp"
        android:gravity="center">

        <shape android:shape="oval">
            <solid android:color="#22000000" />
            <stroke
                android:width="2dp"
                android:color="#66FFC857" />
        </shape>
    </item>

    <item
        android:width="148dp"
        android:height="148dp"
        android:gravity="center">

        <shape android:shape="oval">
            <solid android:color="#33000000" />
            <stroke
                android:width="1dp"
                android:color="#99FFFFFF" />
        </shape>
    </item>

</layer-list>